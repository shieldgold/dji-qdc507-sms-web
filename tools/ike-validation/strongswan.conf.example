# Offline reference only. Not installed or activated on the QDC507.
# Match the module's missing IPv4 policy-routing tables with routing_table=0.
# Connections, credentials, and real routing/DNS behavior need separate testing.
charon {
  threads = 16
  load_modular = no
  load = random nonce aes des sha1 sha2 md4 mgf1 hmac kdf gmp curve25519 gcm ctr drbg x509 pubkey pkcs1 pkcs8 pem constraints revocation kernel-libipsec kernel-netlink socket-default vici eap-identity eap-mschapv2 counters
  routing_table = 0
  install_routes = no
  install_virtual_ip = no
  plugins {
    kernel-libipsec {
      raw_esp = no
    }
  }
}
